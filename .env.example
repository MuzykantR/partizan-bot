# Telegram Bot Configuration
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
WEB_APP_URL=https://your-domain.com/twa
BOT_MODE=polling

# Marzban REST API Configuration
MARZBAN_URL=http://127.0.0.1:8000
MARZBAN_USERNAME=bot_admin
MARZBAN_PASSWORD=your_secure_marzban_password
ENABLE_MARZBAN_MOCK=false

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8001
ALLOWED_ORIGINS=https://your-domain.com,https://web.telegram.org,https://t.me

# Business Logic
TRIAL_DAYS=3
REFERRAL_BONUS_DAYS=7
REFERRAL_NEW_USER_BONUS_DAYS=3

# Optional Webhook Security
WEBHOOK_URL=https://your-domain.com/api/v1/bot/webhook
WEBHOOK_SECRET=your_random_webhook_secret_token
